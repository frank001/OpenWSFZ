<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- TESTING_STRATEGY.md §4.7: measurement-arm test classes (currently just
         AwgnFpReplayTests) are excluded from "both the default local run and CI"
         by convention. CI already enforces this via pre_merge_check.py's own
         filter flag (Category!=AwgnFpReplay), but a bare "dotnet test" had no way
         to know that and ran the real, roughly 9 minute decode payload anyway
         (2026-09-12, QA). VSTestTestCaseFilter is dotnet test's project level
         default filter, applied automatically and overridden by any filter flag
         passed on the command line, so explicitly asking for Category=AwgnFpReplay
         still runs the arm on demand, per §4.7's "runnable with one explicit flag". -->
    <VSTestTestCaseFilter>Category!=AwgnFpReplay</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="..\..\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OpenWSFZ.Daemon\OpenWSFZ.Daemon.csproj" />
    <ProjectReference Include="..\OpenWSFZ.TestSupport\OpenWSFZ.TestSupport.csproj" />
  </ItemGroup>

  <!-- Synthetic FT8 WAV fixtures and their answer-key subsets (FR-029).
       Fictional example callsigns only (Q1AW / Q1ABC / Q9XYZ); no real
       third-party operators. Regenerate via qa/rr-study/gen_decoder_fixtures.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\synth-qso-01.wav" />
    <EmbeddedResource Include="Fixtures\synth-qso-01.expected.txt" />
    <EmbeddedResource Include="Fixtures\synth-qso-02.wav" />
    <EmbeddedResource Include="Fixtures\synth-qso-02.expected.txt" />
    <EmbeddedResource Include="Fixtures\synth-qso-03.wav" />
    <EmbeddedResource Include="Fixtures\synth-qso-03.expected.txt" />
  </ItemGroup>


</Project>
