<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Enable the Roslyn RequestDelegateGenerator source generator so that MapGet/MapPost
      lambdas are resolved at compile time rather than via reflection.
      Required for AOT publish of OpenWSFZ.Daemon (which references this library).
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
    <ProjectReference Include="..\OpenWSFZ.Audio\OpenWSFZ.Audio.csproj" />
    <ProjectReference Include="..\OpenWSFZ.Config\OpenWSFZ.Config.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" /></ItemGroup>

  <ItemGroup>
    <!-- Expose internal types (AudioWatchdog, etc.) to the Web test project. -->
    <InternalsVisibleTo Include="OpenWSFZ.Web.Tests" />
    <!--
      external-reporting-single-connection: ExternalReportingService (OpenWSFZ.Daemon) reuses
      AppJsonContext's source-generated RelayBatchRequest/RelayDatagramDto serialisation for its
      outbound POST /api/v1/external-reporting/relay body — the exact same AOT-safe context the
      leader-side endpoint deserialises with — rather than duplicating the DTO shape and a second
      source-gen context. Mirrors OpenWSFZ.Rig's existing InternalsVisibleTo to OpenWSFZ.Daemon.
    -->
    <InternalsVisibleTo Include="OpenWSFZ.Daemon" />
  </ItemGroup>
</Project>
