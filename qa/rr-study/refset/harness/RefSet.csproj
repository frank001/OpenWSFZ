<Project Sdk="Microsoft.NET.Sdk">

  <!--
    REFERENCE-SET replay harness, legs A and D (QA-owned; no src/ or native/ change). Platform-neutral: builds and runs on Windows and Linux.
    Spec: REFERENCE-SET 2c, 2i, 2k, 2l (arch/reference-set). Derived from the W-pilot harness (qa/rr-study/refset/wpilot).

      dotnet build RefSet.csproj -c Release -p:RepoRoot=<checkout> -o <out>

    <checkout> is the build under test (the checkout whose src/OpenWSFZ.Ft8 and native library are replayed).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
  </ItemGroup>

</Project>
