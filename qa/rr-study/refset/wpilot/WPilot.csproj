<Project Sdk="Microsoft.NET.Sdk">

  <!--
    REFERENCE-SET W-pilot harness (QA-owned; no src/ change). Spec: REFERENCE-SET 2c item 3 + 2f item 4
    (arch/reference-set). Built against the on-air checkout 421e3ce2 (DI sync 5, shim 20260061, DLL a14fe354...),
    exactly like the STRONG-MISS harness it is derived from.

      dotnet build WPilot.csproj -c Release -p:RepoRoot=<checkout> -o <out>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
  </ItemGroup>

</Project>
