<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COH-FALLBACK step 4, row A2(e') (spec section 16): the PARALLEL path (CohFallbackParallelRunner.Run, 8 workers, no deadline) against the
    single-thread run (Ft8LibInterop.CohFallbackRun) on the same snapshot of the same cycles; the published payload LIST, IN ORDER, must be
    identical N/N. QA-owned; no src/ change: the internal types are reached by reflection.

      dotnet build A2ep.csproj -c Release -p:RepoRoot=<checkout of the build under test> -o <out>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
  </ItemGroup>

</Project>
