<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SUB-FEAS §8.1 real-band runtime replay harness (QA-owned; no src/ change).
    It references the Ft8 library of WHATEVER checkout RepoRoot points at, so the same harness
    source is built three times: against the build under test (2b39cf18, which has
    SetSubtractionEnabled: -p:HasSubfeas=true) and against the two builds that produced the
    endurance archives (84cac119, 51e40b55, which do not: HasSubfeas unset, R0 only).

      dotnet build Replay81.csproj -c Release -p:RepoRoot=<checkout> [-p:HasSubfeas=true] -o <out>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</RepoRoot>
    <DefineConstants Condition="'$(HasSubfeas)' == 'true'">$(DefineConstants);HAS_SUBFEAS</DefineConstants>
    <!-- sub-feas-speed-redesign: only the candidate build (ca0bcd9b) has SetSubtractionMaxThreads. -->
    <DefineConstants Condition="'$(HasMaxThreads)' == 'true'">$(DefineConstants);HAS_MAXTHREADS</DefineConstants>
    <!-- sub-feas two-stage publish: only the two-stage build (247ac391) has DecodeTwoStageAsync. -->
    <DefineConstants Condition="'$(HasTwoStage)' == 'true'">$(DefineConstants);HAS_TWOSTAGE</DefineConstants>
    <!-- osd-sign-fix (#215): only the build with Ft8Decoder.SetOsdSignFix / GetOsdSignFix (shim 20260060+). With it, the osd-sign-fix argument (0 or 1) is REQUIRED and read back. -->
    <DefineConstants Condition="'$(HasOsdSignFix)' == 'true'">$(DefineConstants);HAS_OSDSIGNFIX</DefineConstants>
    <!-- third-pass-deep (#240): only the build with Ft8Decoder.SetDecodingDepth / DecodeStagedAsync (feat/third-pass-deep a329cea9). Needs HasTwoStage and HasSubfeas too (modes three0 / three1). -->
    <DefineConstants Condition="'$(HasThirdPass)' == 'true'">$(DefineConstants);HAS_THIRDPASS</DefineConstants>
    <!-- #225 phase 2 (shim 20260064): only the build with Ft8Decoder.GetUnsupportedTypeCounts (feat/dxpedition-decode-225). -->
    <DefineConstants Condition="'$(HasDxped)' == 'true'">$(DefineConstants);HAS_DXPED</DefineConstants>
    <!-- COH-FALLBACK step 3 Stage 2 (shim 20260068): only the build with Ft8Decoder.SetCoherentFallbackEnabled and DecodeResult.Path (feat/coh-fallback-stage1 1405ada4). Needs HasThirdPass too. -->
    <DefineConstants Condition="'$(HasCohFb)' == 'true'">$(DefineConstants);HAS_COHFB</DefineConstants>
    <!-- COH-FALLBACK step 4 (shim 20260069): the fallback runs after the last ordinary batch and publishes its OWN batch (4 on Deep); the cycle log line carries workers/fbStartMs/fbWallMs/batch/batch4Published/batch4PublishMs. Needs HasCohFb too. -->
    <DefineConstants Condition="'$(HasCohFb4)' == 'true'">$(DefineConstants);HAS_COHFB4</DefineConstants>
    <!-- COH-MULTISET-BUILD (shim 20260071): only the build with Ft8Decoder.SetCoherentFallbackMultiSet; the cohms argument (0 or 1) is then REQUIRED and read back. Needs HasCohFb4 too. -->
    <DefineConstants Condition="'$(HasCohMs)' == 'true'">$(DefineConstants);HAS_COHMS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
  </ItemGroup>

</Project>
