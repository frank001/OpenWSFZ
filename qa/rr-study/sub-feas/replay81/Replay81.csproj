<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SUB-FEAS §8.1 real-band runtime replay harness (QA-owned; no src/ change).
    It references the Ft8 library of WHATEVER checkout RepoRoot points at, so the same harness
    source is built three times: against the build under test (2b39cf18, which has
    SetSubtractionEnabled: -p:HasSubfeas=true) and against the two builds that produced the
    endurance archives (84cac119, 51e40b55, which do not: HasSubfeas unset, R0 only).

      dotnet build Replay81.csproj -c Release -p:RepoRoot=<checkout> [-p:HasSubfeas=true] -o <out>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</RepoRoot>
    <DefineConstants Condition="'$(HasSubfeas)' == 'true'">$(DefineConstants);HAS_SUBFEAS</DefineConstants>
    <!-- sub-feas-speed-redesign: only the candidate build (ca0bcd9b) has SetSubtractionMaxThreads. -->
    <DefineConstants Condition="'$(HasMaxThreads)' == 'true'">$(DefineConstants);HAS_MAXTHREADS</DefineConstants>
    <!-- sub-feas two-stage publish: only the two-stage build (247ac391) has DecodeTwoStageAsync. -->
    <DefineConstants Condition="'$(HasTwoStage)' == 'true'">$(DefineConstants);HAS_TWOSTAGE</DefineConstants>
    <!-- osd-sign-fix (#215): only the build with Ft8Decoder.SetOsdSignFix / GetOsdSignFix (shim 20260060+). With it, the osd-sign-fix argument (0 or 1) is REQUIRED and read back. -->
    <DefineConstants Condition="'$(HasOsdSignFix)' == 'true'">$(DefineConstants);HAS_OSDSIGNFIX</DefineConstants>
    <!-- third-pass-deep (#240): only the build with Ft8Decoder.SetDecodingDepth / DecodeStagedAsync (feat/third-pass-deep a329cea9). Needs HasTwoStage and HasSubfeas too (modes three0 / three1). -->
    <DefineConstants Condition="'$(HasThirdPass)' == 'true'">$(DefineConstants);HAS_THIRDPASS</DefineConstants>
    <!-- #225 phase 2 (shim 20260064): only the build with Ft8Decoder.GetUnsupportedTypeCounts (feat/dxpedition-decode-225). -->
    <DefineConstants Condition="'$(HasDxped)' == 'true'">$(DefineConstants);HAS_DXPED</DefineConstants>
    <!-- COH-FALLBACK step 3 Stage 2 (shim 20260068): only the build with Ft8Decoder.SetCoherentFallbackEnabled and DecodeResult.Path (feat/coh-fallback-stage1 1405ada4). Needs HasThirdPass too. -->
    <DefineConstants Condition="'$(HasCohFb)' == 'true'">$(DefineConstants);HAS_COHFB</DefineConstants>
    <!-- COH-FALLBACK step 4 (shim 20260069): the fallback runs after the last ordinary batch and publishes its OWN batch (4 on Deep); the cycle log line carries workers/fbStartMs/fbWallMs/batch/batch4Published/batch4PublishMs. Needs HasCohFb too. -->
    <DefineConstants Condition="'$(HasCohFb4)' == 'true'">$(DefineConstants);HAS_COHFB4</DefineConstants>
    <!-- L1' build (decoder.lateSubtractionRound, spec 1322 section 7 F5): the staged decode may deliver a batch 5; run.csv gains b5_n,tb5_ms, the outcome/test-B/nc-dump outputs gain kind b5. Needs HasCohFb4. Absent => output byte-identical to builds before it. -->
    <DefineConstants Condition="'$(HasLateRound)' == 'true'">$(DefineConstants);HAS_LATEROUND</DefineConstants>
    <!-- COH-MULTISET-BUILD (shim 20260071): only the build with Ft8Decoder.SetCoherentFallbackMultiSet; the cohms argument (0 or 1) is then REQUIRED and read back. Needs HasCohFb4 too. -->
    <DefineConstants Condition="'$(HasCohMs)' == 'true'">$(DefineConstants);HAS_COHMS</DefineConstants>
      <DefineConstants Condition="'$(HasCohAudio)' == 'true'">$(DefineConstants);HAS_COHAUDIO</DefineConstants>
    <!-- COH-RES-CAND (#272, build b0d01f4f): only the build with Ft8Decoder.SetCoherentFallbackResidualCandidates; the cohrescand argument (0 or 1) is then REQUIRED and read back. Needs HasCohAudio too. -->
    <DefineConstants Condition="'$(HasCohResCand)' == 'true'">$(DefineConstants);HAS_COHRESCAND</DefineConstants>
    <!-- CQ-AP (build 7ca00264): only the build with Ft8Decoder.SetCqApEnabled and DecodeResult.ApKind; the cq-ap argument (0 or 1) is then REQUIRED and read back, and the nc-dump gains a trailing apKind column. Needs HasLateRound and HasUngated (the default-ON build line). -->
    <DefineConstants Condition="'$(HasCqAp)' == 'true'">$(DefineConstants);HAS_CQAP</DefineConstants>
    <!-- GAP-RELOCATE item 1: build as assembly Ft8.FitProbe (already in OpenWSFZ.Ft8's InternalsVisibleTo) to use the internal Ft8Decoder constructor with a counting pass-through interop (StageProbe.cs). -->
    <DefineConstants Condition="'$(HasUngated)' == 'true'">$(DefineConstants);HAS_UNGATED</DefineConstants>
    <!-- XC-BUILD (dev task 2026-11-13-xc-template-build): only the build with Ft8Decoder.SetCrossCyclePrior / SetCrossCyclePriorShadow / SetCrossCyclePriorThreshold, CrossCyclePriorProbe and batch 6; the xc-prior, xc-shadow and xc-te arguments are then REQUIRED and read back. Needs HasCohResCand, HasCqAp and HasInternals too. -->
    <DefineConstants Condition="'$(HasXcPrior)' == 'true'">$(DefineConstants);HAS_XCPRIOR</DefineConstants>
    <!-- XC-BUILD remedy (Amendment 6, dev task 2026-11-14-xc-template-remedy, build 4b70e418): only the build with SetCrossCyclePriorColocationVeto / SetCrossCyclePriorParityThreshold and the extended sink record (SP, PriorFreqHz, PriorDt, PriorBatch, Vetoed). Needs HasXcPrior too. The xc-veto and xc-tp arguments are then REQUIRED and read back as xcveto= and xctp=. -->
    <DefineConstants Condition="'$(HasXcRemedy)' == 'true'">$(DefineConstants);HAS_XCREMEDY</DefineConstants>
    <!-- LR-FULL (dev commit 80bbd74b, feat/lr-full-diag): only the build with Ft8Decoder.SetDiagThirdRunUngated / SetDiagLateFallbackOnResidual and the internal DiagRowTagSink; the lr-x1 and lr-x2 arguments (0 or 1) are then REQUIRED and read back, the nc-dump gains a trailing step column after the apKind, and the two 'Diagnostic X' count lines go to the log. Needs HasCqAp and HasInternals. -->
    <DefineConstants Condition="'$(HasLrFull)' == 'true'">$(DefineConstants);HAS_LRFULL</DefineConstants>
    <!-- LR-BUILD (dev commit c23aa7e9, feat/lr-full): the PRODUCT setters Ft8Decoder.SetCoherentFallbackResidualCandidatesUngated (X1) / SetLateRoundFallback (X2); lr-x1 and lr-x2 (0 or 1) are REQUIRED and read back; rows carry their Path (4 X1, 5 X2) in the nc-dump's path column; the counts-only 'Late provenance:' line goes to the log. Never together with HasLrFull. -->
    <DefineConstants Condition="'$(HasLrBuild)' == 'true'">$(DefineConstants);HAS_LRBUILD</DefineConstants>
    <!-- DR-2 step 2d (lean decoder, feat/lean-2d): only the build with Ft8Decoder.SetEngine / SetLeanThreads / SetEffort (shim 20260076). The engine argument (classic or lean) is then REQUIRED; the lean-threads, effort and lean-out arguments are optional. Needs HasCohFb4 (DecodeStagedAsync). -->
    <DefineConstants Condition="'$(HasLean)' == 'true'">$(DefineConstants);HAS_LEAN</DefineConstants>
    <!-- SUB-PROBE (feat/sub-probe fc3d5b5c, shim 20260080): only the build with LeanCycleParams.Probe / LeanCycleOutcome.ProbeRows. Needs HasLean. The harness options lean-probe=1 and probe-out=PATH (under _qa-scratch) write one TSV row per probe row (numbers only). -->
    <DefineConstants Condition="'$(HasProbe)' == 'true'">$(DefineConstants);HAS_PROBE</DefineConstants>
    <!-- XC-ROUND (feat/xc-round, shim 20260082): only the build with IFt8NativeInterop.DecodeLeanXcRound / LeanXcDetection. Needs HasLean (and HasInternals). The StageProbeInterop wrapper MUST forward the round (the interface default is an empty outcome: without the forward the round never runs); with HasProbe its round-4 rows go to the probe-out file under the cycle's stamp. -->
    <DefineConstants Condition="'$(HasXcRound)' == 'true'">$(DefineConstants);HAS_XCROUND</DefineConstants>
    <!-- KNOWN-ERASURE (shim 20260083): the build whose DecodeLeanXcRound has the fifth parameter (the known results). Needs HasXcRound. -->
    <DefineConstants Condition="'$(HasXcKnown)' == 'true'">$(DefineConstants);HAS_XCKNOWN</DefineConstants>
    <!-- FINE-GRID (shim 20260083): the build whose LeanCycleParams has Thin, TimeOsr, FreqOsr and whose probe rows carry TimeSub and FreqSub. Needs HasLean and HasProbe. The StageProbeInterop wrapper sets them on every lean request (the decoder has no setter for them), from the harness options lean-thin, lean-time-osr and lean-freq-osr. -->
    <DefineConstants Condition="'$(HasFineGrid)' == 'true'">$(DefineConstants);HAS_FINEGRID</DefineConstants>
    <DefineConstants Condition="'$(HasInternals)' == 'true'">$(DefineConstants);HAS_INTERNALS</DefineConstants>
    <AssemblyName Condition="'$(HasInternals)' == 'true'">Ft8.FitProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenWSFZ.Abstractions\OpenWSFZ.Abstractions.csproj" />
  </ItemGroup>

</Project>
