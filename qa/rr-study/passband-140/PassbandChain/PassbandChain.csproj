<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PASSBAND-140 managed chain (spec section 3.1): TrimEnd, then text dedup, then
    the PRODUCTION Ft8Decoder.IsPlausibleMessage, called by reflection since it is
    `internal static` (Ft8Decoder.cs:568): this is qa-tooling reaching into the
    real assembly, not a src/ change (no InternalsVisibleTo grant added anywhere).
    CallsignGrammarStore is built exactly as Program.cs:115-123 builds it
    (OpenWSFZ.Daemon.CallsignGrammarStore, from the station's own
    callsign-grammar.json beside config.json).

    Spec: qa/rr-study/2026-09-14-1542-architect-to-qa-spec-g2b-140-passband-rearm.md
    section 3.1 / ROW 0c. Not part of OpenWSFZ.slnx / not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PassbandChain</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
