<Project Sdk="Microsoft.NET.Sdk">
  <!-- FD-PROXY N-RAND harness. AssemblyName Ft8.FitProbe so the product's InternalsVisibleTo reaches Ft8LibInterop and Ft8Decoder.IsPlausibleMessage (no src/ change).
       Build: dotnet build -c Release -o <out> -p:TreeRoot=<scratch checkout of 66b3ddf1> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Ft8.FitProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TreeRoot)\src\OpenWSFZ.Ft8\OpenWSFZ.Ft8.csproj" />
  </ItemGroup>
</Project>
